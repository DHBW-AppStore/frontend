              <line x1="6" x2="6.01" y1="18" y2="18"></line>
            </svg>
            <h3 class="text-sm font-bold uppercase tracking-wider text-gray-600"> Virtuelle Maschinen </h3><span class="px-2 py-0.5 bg-gray-100 text-gray-600 text-xs font-bold rounded">1</span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div class="bg-white rounded-lg p-4 border-2 shadow-sm flex flex-col gap-3 transition-colors border-gray-200">
              <!-- Header: Team-Badge + VM-Name + Lifecycle-Pill -->
              <div class="flex items-start justify-between gap-2">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1"><span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded border bg-blue-100 text-blue-700 border-blue-200">Team Alpha</span></div>
