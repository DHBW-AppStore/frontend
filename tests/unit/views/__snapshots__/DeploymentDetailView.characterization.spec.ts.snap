          <div class="flex items-center gap-2 mb-3"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide text-gray-400 lucide-server-icon lucide-server text-gray-400">
              <rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect>
