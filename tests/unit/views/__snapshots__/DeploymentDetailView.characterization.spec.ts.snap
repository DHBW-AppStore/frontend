              <path d="M3 6h18"></path>
              <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg><span class="font-medium">Löschen</span></button>
        </div>
      </div><!-- Main info grid with 3 cards -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Deployment info card -->
