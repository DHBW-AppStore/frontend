            </svg>
            <h3 class="text-sm font-bold uppercase tracking-wider text-gray-600"> Netzwerk </h3><span class="px-2 py-0.5 bg-gray-100 text-gray-600 text-xs font-bold rounded">3</span>
          </div>
          <ul class="space-y-1.5 text-xs">
            <li class="px-3 py-2 bg-gray-50 rounded-lg border border-gray-100 flex items-center justify-between">
              <div class="min-w-0">
                <p class="font-semibold text-gray-900 truncate">lab-net</p>
