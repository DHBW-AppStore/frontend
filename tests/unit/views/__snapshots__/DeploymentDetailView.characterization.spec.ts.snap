            <div>
              <div class="text-xs text-fg-muted uppercase tracking-wide mb-1">Rolle</div>
              <div class="text-sm"><span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-line/[.07] text-fg border border-strong capitalize">teacher</span></div>
            </div>
          </div>
