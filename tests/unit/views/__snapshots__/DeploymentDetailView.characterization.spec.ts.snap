        </div>
        <div class="space-y-4">
          <div class="border border-subtle rounded-lg overflow-hidden">
            <div class="bg-line/[.04] px-4 py-3 flex items-center justify-between border-b border-subtle">
              <div class="flex items-center gap-2"><span class="font-semibold text-fg">Team Alpha</span><span class="text-xs text-fg-muted">·</span><span class="text-xs text-fg-muted">2 members</span></div>
            </div>
            <div>
              <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 px-4 py-4 border-b border-subtle last:border-b-0 hover:bg-line/[.04] transition-colors">
