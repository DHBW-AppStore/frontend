              <div class="w-2.5 h-2.5 rounded-full transition-all bg-icon"></div><span class="text-[10px] uppercase tracking-wide font-medium whitespace-nowrap text-center text-fg">Starting</span>
            </div>
            <div class="flex-1 h-px min-w-[8px] mt-[5px] bg-line/[.18]"></div>
            <div class="flex-shrink-0 flex flex-col items-center gap-2 min-w-[60px]">
              <div class="w-2.5 h-2.5 rounded-full transition-all bg-icon"></div><span class="text-[10px] uppercase tracking-wide font-medium whitespace-nowrap text-center text-fg">Openstack Setup</span>
            </div>
            <div class="flex-1 h-px min-w-[8px] mt-[5px] bg-line/[.18]"></div>
            <div class="flex-shrink-0 flex flex-col items-center gap-2 min-w-[60px]">
              <div class="w-2.5 h-2.5 rounded-full transition-all bg-icon"></div><span class="text-[10px] uppercase tracking-wide font-medium whitespace-nowrap text-center text-fg">Git Clone</span>
            </div>
            <div class="flex-1 h-px min-w-[8px] mt-[5px] bg-line/[.18]"></div>
            <div class="flex-shrink-0 flex flex-col items-center gap-2 min-w-[60px]">
              <div class="w-2.5 h-2.5 rounded-full transition-all bg-icon"></div><span class="text-[10px] uppercase tracking-wide font-medium whitespace-nowrap text-center text-fg">Creds Materialise</span>
            </div>
            <div class="flex-1 h-px min-w-[8px] mt-[5px] bg-line/[.18]"></div>
            <div class="flex-shrink-0 flex flex-col items-center gap-2 min-w-[60px]">
              <div class="w-2.5 h-2.5 rounded-full transition-all bg-icon ring-4 ring-accent/30 scale-125"></div><span class="text-[10px] uppercase tracking-wide font-medium whitespace-nowrap text-center text-fg">Packer Init</span>
            </div>
            <div class="flex-1 h-px min-w-[8px] mt-[5px] bg-line/[.12]"></div>
            <div class="flex-shrink-0 flex flex-col items-center gap-2 min-w-[60px]">
              <div class="w-2.5 h-2.5 rounded-full transition-all bg-line/[.12]"></div><span class="text-[10px] uppercase tracking-wide font-medium whitespace-nowrap text-center text-fg-muted">Packer Validate</span>
            </div>
            <div class="flex-1 h-px min-w-[8px] mt-[5px] bg-line/[.12]"></div>
            <div class="flex-shrink-0 flex flex-col items-center gap-2 min-w-[60px]">
              <div class="w-2.5 h-2.5 rounded-full transition-all bg-line/[.12]"></div><span class="text-[10px] uppercase tracking-wide font-medium whitespace-nowrap text-center text-fg-muted">Packer Build</span>
            </div>
            <div class="flex-1 h-px min-w-[8px] mt-[5px] bg-line/[.12]"></div>
            <div class="flex-shrink-0 flex flex-col items-center gap-2 min-w-[60px]">
              <div class="w-2.5 h-2.5 rounded-full transition-all bg-line/[.12]"></div><span class="text-[10px] uppercase tracking-wide font-medium whitespace-nowrap text-center text-fg-muted">Terraform Init</span>
            </div>
            <div class="flex-1 h-px min-w-[8px] mt-[5px] bg-line/[.12]"></div>
            <div class="flex-shrink-0 flex flex-col items-center gap-2 min-w-[60px]">
              <div class="w-2.5 h-2.5 rounded-full transition-all bg-line/[.12]"></div><span class="text-[10px] uppercase tracking-wide font-medium whitespace-nowrap text-center text-fg-muted">Terraform Plan</span>
            </div>
            <div class="flex-1 h-px min-w-[8px] mt-[5px] bg-line/[.12]"></div>
            <div class="flex-shrink-0 flex flex-col items-center gap-2 min-w-[60px]">
              <div class="w-2.5 h-2.5 rounded-full transition-all bg-line/[.12]"></div><span class="text-[10px] uppercase tracking-wide font-medium whitespace-nowrap text-center text-fg-muted">Terraform Apply</span>
            </div>
            <div class="flex-1 h-px min-w-[8px] mt-[5px] bg-line/[.12]"></div>
            <div class="flex-shrink-0 flex flex-col items-center gap-2 min-w-[60px]">
              <div class="w-2.5 h-2.5 rounded-full transition-all bg-line/[.12]"></div><span class="text-[10px] uppercase tracking-wide font-medium whitespace-nowrap text-center text-fg-muted">Outputs And Cleanup</span>
            </div>
            <!--v-if-->
          </div>
          <!-- Live log tail. \`\`streamTotalLogCount\`\` keeps
